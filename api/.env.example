PORT=8080
SYSLOG_PORT=5514
DATABASE_URL=postgresql://opsmate:opsmate_secret@localhost:5432/opsmate
# If 5432 is already used by another Postgres, start v2 db on 5433:
#   docker compose up -d
#   DATABASE_URL=postgresql://opsmate:opsmate_secret@localhost:5433/opsmate

DEMO_API_URL=http://localhost:3001
DEMO_SERVICE_NAME=demo
# Primary LLM (diagnosis + chat). Groq free: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback LLM when Groq fails / times out
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Per-provider attempt timeout before failover (demo-friendly default 12s)
LLM_TIMEOUT_MS=12000
# Token budgets (chat needs more room than short incident JSON)
DIAGNOSIS_MAX_TOKENS=450
CHAT_MAX_TOKENS=1400
SESSION_SECRET=change-me-long-random
NODE_ENV=development
# Optional service-level defaults (dashboard uses Connect UI for user PAT)
# ZEROPS_API_TOKEN=
# ZEROPS_PROJECT_ID=
